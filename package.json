{
  "name": "tokyo-hiker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vitepress build contents",
    "cleanup": "./scripts/cleanup-temp-files.sh",
    "code-format": "prettier --write .",
    "code-format:check": "prettier --check .",
    "dev": "vitepress dev contents",
    "index": "zsh scripts/index.sh",
    "lint": "pnpm run lint-code && pnpm run lint-md",
    "lint-code": "prettier --write .",
    "lint-contents": "prettier --write contents && markdownlint-cli2 --fix \"contents/**/*.md\"",
    "lint-md": "markdownlint-cli2 --fix \"**/*.md\"",
    "lint-naming": "node skills/file-folder-name-linter/scripts/lint-names.mjs",
    "lint-target": "node scripts/lint-target.mjs",
    "pdf-to-images": "node scripts/pdf-to-images.mjs",
    "preview": "pnpm run build && pnpm vitepress-preview",
    "setup-brew": "./scripts/setup-brew.sh",
    "setup-full": "zsh scripts/setup.sh",
    "setup-node": "./scripts/setup-node.sh",
    "setup-pre-commit": "./scripts/setup-pre-commit.sh",
    "setup-takumi-guard": "./scripts/setup-takumi-guard.sh",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "tree": "node scripts/generate-site-structure.mjs",
    "vitepress-preview": "vitepress preview contents"
  },
  "devDependencies": {
    "@davidingplus/vitepress-image-viewer": "^1.1.5",
    "@nolebase/vitepress-plugin-enhanced-readabilities": "^2.18.2",
    "@nolebase/vitepress-plugin-meta": "^2.18.2",
    "@prettier/plugin-xml": "^3.4.2",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vite-pwa/vitepress": "^1.1.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "init": "^0.1.2",
    "js-yaml": "^5.3.0",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-rule-relative-links": "^5.1.2",
    "markdownlint-rule-search-replace": "^1.2.0",
    "openai": "^7.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sh": "^0.19.0",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-toml": "^2.0.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "2.0.0-alpha.12",
    "vitepress-mermaid-renderer": "^1.2.0",
    "vitepress-sidebar": "^1.38.0",
    "vue": "^3.5.41"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
